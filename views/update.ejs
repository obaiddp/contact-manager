<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<!-- <body class="bg-gray-100 min-h-screen"> -->
<body>
    <!-- Navigation -->
    <nav class="bg-blue-600 text-white p-5">
        <div class="container flex mx-auto items-center justify-between">
            <h1 class="text-xl font-bold">Contact Manager</h1>
            <div class="flex gap-1 space-x-4">
                <span class="text-lg hidden md:inline">Welcome, <%= currentUser.username %></span>
                <a href="/logout" class="px-3 py-1 bg-red-900 rounded">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Body -->
    <div class="container mx-auto p-4 md:p-6">
        <div class="flex flex-col md:flex-row gap-5">

            <!-- Section 1 -->
            <div class="md:w-1/3 bg-white p-6 rounded-lg shadow-md">
                
                <h1 class="text-xl mb-6 font-bold">Edit Contact</h1>

                <form action="/update/<%= contact._id %>" method="POST" class="space-y-4">
                    
                    <!-- name -->
                    <input 
                        type="text" 
                        name="name"
                        placeholder="Name..."
                        value="<%= contact.name %>"
                        required 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md">
                    
                    <!-- email -->
                    <input 
                        type="email" 
                        name="email"
                        placeholder="Email..."
                        value="<%= contact.email %>"
                        required 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md">

                     <!-- phone number -->
                     <input 
                        type="tel" 
                        name="phoneNumber"
                        placeholder="(123) 456-7890"
                        value="<%= contact.phoneNo %>"
                        required 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md">

                    <button 
                        class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                        type="submit">
                            Update</button>
                </form>
            </div>

                        
        </div>
    </div>

</body>
</html>